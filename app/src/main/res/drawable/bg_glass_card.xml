<?xml version="1.0" encoding="utf-8"?>
<!-- Glasscheiben-Look: leicht transparenter Verlauf + heller Rand oben (Licht-Reflexion) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_fill_strong"
                android:endColor="@color/glass_fill"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
