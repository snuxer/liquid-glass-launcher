<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Animierter Liquid-Glass-Hintergrund (keine Wallpaper-Berechtigung nötig) -->
    <com.example.liquidglasslauncher.LiquidBackgroundView
        android:id="@+id/liquidBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/scrim_top_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/scrim_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Uhr-Widget in Glas-Karte -->
    <LinearLayout
        android:id="@+id/clockCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_glass_card"
        android:paddingHorizontal="32dp"
        android:paddingVertical="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp">

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="56sp"
            android:fontFamily="sans-serif-light"
            tools:text="14:32" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            tools:text="Dienstag, 15. September" />
    </LinearLayout>

    <!-- Tippbarer Button als verlässliche Alternative zur Swipe-Geste -->
    <LinearLayout
        android:id="@+id/openDrawerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/dock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌃  Alle Apps"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Dock: feste Favoriten-Icons in Glas-Pille, ohne Beschriftung -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="6dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App-Drawer: Glas-Panel, das von unten hochgezogen wird -->
    <FrameLayout
        android:id="@+id/appDrawerPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_drawer"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="56dp">

            <EditText
                android:id="@+id/searchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_pill"
                android:hint="@string/search_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appDrawerRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="32dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
